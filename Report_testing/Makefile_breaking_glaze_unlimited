CC = gcc
CFLAGS = -Wall -Wextra -O3 -std=c99 -D_POSIX_C_SOURCE=200809L
LDFLAGS = -lm

TARGET = breaking_glaze_with_memset_unlimited
SOURCE = breaking_glaze_with_memset_unlimited.c

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(SOURCE)
	$(CC) $(CFLAGS) -o $(TARGET) $(SOURCE) $(LDFLAGS)

clean:
	rm -f $(TARGET) checkpoint_log.dat reconstructed_state.txt

# Usage examples:
# make -f Makefile_breaking_glaze_unlimited
# ./breaking_glaze_with_memset_unlimited 5000000    # 5 million accounts
# ./breaking_glaze_with_memset_unlimited 1000000    # 1 million accounts 