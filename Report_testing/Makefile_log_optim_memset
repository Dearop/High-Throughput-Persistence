CC = gcc
CFLAGS = -Wall -Wextra -O3 -std=c99 -pthread -D_POSIX_C_SOURCE=200809L
LDFLAGS = -pthread -lm

TARGET = log_optim_with_memset
SOURCE = log_optim_with_memset.c

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(SOURCE)
	$(CC) $(CFLAGS) -o $(TARGET) $(SOURCE) $(LDFLAGS)

clean:
	rm -f $(TARGET) state_log.bin state_snapshot.bin

